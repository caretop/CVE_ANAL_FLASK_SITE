# "csv" (default, primary) or "mongo" (force MongoDB only).
# When DATA_SOURCE=csv and the CSV below is missing/empty, the app
# automatically falls back to MongoDB -- no setup required to try it.
DATA_SOURCE=csv

# Primary data file when DATA_SOURCE=csv, and the seed source for MongoDB.
KEV_CSV_PATH=data/known_exploited_vulnerabilities.csv

# Used as the fallback when the CSV is unavailable, or when DATA_SOURCE=mongo.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=kev_db
MONGO_COLLECTION=vulnerabilities

FLASK_DEBUG=1
