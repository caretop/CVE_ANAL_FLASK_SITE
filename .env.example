# "csv" (default) or "mongo"
DATA_SOURCE=csv

# Used when DATA_SOURCE=csv. Defaults to data/known_exploited_vulnerabilities.csv
KEV_CSV_PATH=data/known_exploited_vulnerabilities.csv

# Used when DATA_SOURCE=mongo
MONGO_URI=mongodb://localhost:27017
MONGO_DB=kev_db
MONGO_COLLECTION=vulnerabilities

FLASK_DEBUG=1
