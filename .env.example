# "mongo" (default, primary) or "csv" (force CSV only).
# When DATA_SOURCE=mongo and MongoDB isn't running/seeded, the app
# automatically falls back to the CSV below -- no setup required to try it.
DATA_SOURCE=mongo

# Used as the primary store when DATA_SOURCE=mongo, and as the fallback/seed
# source either way.
KEV_CSV_PATH=data/known_exploited_vulnerabilities.csv

# Used when DATA_SOURCE=mongo. Local desktop MongoDB by default.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=kev_db
MONGO_COLLECTION=vulnerabilities

FLASK_DEBUG=1
